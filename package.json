{
  "name": "dsh-image-studio",
  "version": "0.2.0",
  "description": "Image generation for the DeepSeek Harness: a model-facing generate_image tool that renders pictures in the conversation, plus a mobile-first settings page for OpenAI-compatible channels. No build step, no runtime dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image-generation",
    "image",
    "gpt-image",
    "openai-compatible",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Megumism/dsh-image-studio.git"
  },
  "homepage": "https://github.com/Megumism/dsh-image-studio#readme",
  "bugs": {
    "url": "https://github.com/Megumism/dsh-image-studio/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/compat.mjs && node test/agent-tool.mjs && node test/host-smoke.mjs && node test/client-smoke.mjs",
    "test:live": "node scripts/verify-live.mjs",
    "install:local": "node scripts/install.mjs"
  },
  "license": "MIT"
}
